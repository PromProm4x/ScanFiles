# ScamShield Environment Configuration
# To use an external PostgreSQL database, uncomment and edit the line below:
# DATABASE_URL=postgresql://user:password@localhost:5432/scamshield
# When DATABASE_URL is not set, ScamShield automatically uses the embedded high-performance database.

# Optional: VirusTotal API Key for enhanced cloud reputation checks
VIRUSTOTAL_API_KEY=

# Server Ports
PORT=5000

